{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "cbom-scan",
          "version": "0.1.0",
          "informationUri": "https://github.com/shubSaurabh/cbom-scan",
          "rules": [
            {
              "id": "broken-algorithm",
              "name": "broken-algorithm",
              "shortDescription": {
                "text": "Broken or deprecated cryptography"
              },
              "fullDescription": {
                "text": "Replace this algorithm now; it is weak even without a quantum computer."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "helpUri": "https://github.com/shubSaurabh/cbom-scan"
            },
            {
              "id": "quantum-vulnerable-algorithm",
              "name": "quantum-vulnerable-algorithm",
              "shortDescription": {
                "text": "Quantum-vulnerable cryptography"
              },
              "fullDescription": {
                "text": "Shor's algorithm breaks this. Add it to your PQC migration plan (ML-KEM, ML-DSA, hybrids)."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "helpUri": "https://github.com/shubSaurabh/cbom-scan"
            },
            {
              "id": "quantum-weakened-algorithm",
              "name": "quantum-weakened-algorithm",
              "shortDescription": {
                "text": "Quantum-weakened cryptography"
              },
              "fullDescription": {
                "text": "Grover's algorithm halves its strength. Prefer 256-bit symmetric keys for long-lived data."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "helpUri": "https://github.com/shubSaurabh/cbom-scan"
            },
            {
              "id": "tls-legacy-protocol",
              "name": "tls-legacy-protocol",
              "shortDescription": {
                "text": "Tls legacy protocol"
              },
              "fullDescription": {
                "text": "Legacy SSL/TLS protocol enabled (SSLv3, TLS 1.0 or 1.1). Require TLS 1.2+, ideally TLS 1.3."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "helpUri": "https://github.com/shubSaurabh/cbom-scan"
            },
            {
              "id": "tls-verification-disabled",
              "name": "tls-verification-disabled",
              "shortDescription": {
                "text": "Tls verification disabled"
              },
              "fullDescription": {
                "text": "TLS certificate verification is disabled, which allows man-in-the-middle attacks."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "helpUri": "https://github.com/shubSaurabh/cbom-scan"
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "quantum-vulnerable-algorithm",
          "level": "warning",
          "message": {
            "text": "ECDH (quantum-vulnerable). Move to hybrid key exchange X25519MLKEM768 (TLS 1.3, OpenSSL 3.5+, Go 1.24+, Chrome, Cloudflare)."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "config/nginx.conf"
                },
                "region": {
                  "startLine": 4
                }
              }
            }
          ]
        },
        {
          "ruleId": "quantum-vulnerable-algorithm",
          "level": "warning",
          "message": {
            "text": "RSA (quantum-vulnerable). Plan migration to ML-KEM (FIPS 203) for key establishment and ML-DSA (FIPS 204) for signatures; use hybrids (e.g. X25519MLKEM768) during transition."
          },
          "locations": [
            {
              "physicalLocation": {
